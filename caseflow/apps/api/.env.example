# ---- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://caseflow:caseflow@127.0.0.1:5432/caseflow?schema=public

# ---- Sessions ---------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=cf_session
SESSION_TTL_HOURS=72
MAGIC_LINK_TTL_MINUTES=15

# ---- Queue ------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# false runs jobs in-process (useful for tests and single-node demos)
QUEUE_ENABLED=true

# ---- File storage -----------------------------------------------------------
# local  -> filesystem, signed download URLs served by the API
# s3     -> any S3-compatible bucket (AWS, MinIO, R2, …). Buckets must be private.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/heic,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ---- Mail -------------------------------------------------------------------
# console -> magic links and notifications are printed to the API log
MAIL_DRIVER=console
MAIL_FROM=CaseFlow <no-reply@caseflow.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT=10
