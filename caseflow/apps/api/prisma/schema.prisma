// CaseFlow — Client Operations Platform
// Multi-tenant: every business entity carries organizationId (directly, or via
// an owning row that does). Tenant scoping is enforced in the data layer, never
// derived from client input.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MANAGER
  SPECIALIST
  CLIENT
}

enum CaseStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PENDING
  ACTIVE
  COMPLETED
  BLOCKED
}

enum RequirementStatus {
  PENDING
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAIVED
}

enum DocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum RequestType {
  DOCUMENT
  INFORMATION
  ACTION
  PAYMENT_CONFIRMATION
  APPOINTMENT
}

enum RequestStatus {
  OPEN
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskVisibility {
  INTERNAL
  CLIENT
  BOTH
}

enum ActorType {
  USER
  CLIENT
  SYSTEM
  INTEGRATION
}

enum EventType {
  CASE_CREATED
  CASE_UPDATED
  CASE_STATUS_CHANGED
  STAGE_CHANGED
  STAGE_COMPLETED
  DOCUMENT_REQUESTED
  DOCUMENT_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  REQUEST_CREATED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
  TASK_CREATED
  TASK_COMPLETED
  MESSAGE_SENT
  DEADLINE_MISSED
  CRM_SYNCED
}

enum CrmProviderKind {
  NONE
  BITRIX24
  AMOCRM
}

enum NotificationChannel {
  EMAIL
  IN_APP
  TELEGRAM
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  logoUrl           String?
  customDomain      String?  @unique
  timezone          String   @default("Europe/Paris")
  primaryColor      String   @default("#1F6FEB")
  supportEmail      String?
  portalWelcomeText String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users         User[]
  clients       Client[]
  cases         Case[]
  documents     Document[]
  requests      ClientRequest[]
  tasks         Task[]
  messages      Message[]
  events        Event[]
  templates     WorkflowTemplate[]
  crm           CrmConnection[]
  notifications Notification[]
  magicLinks    MagicLinkToken[]
  sessions      Session[]

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String
  role           Role      @default(SPECIALIST)
  avatarUrl      String?
  clientId       String?   @unique
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  assignedCases   Case[]          @relation("CaseAssignee")
  assignedTasks   Task[]          @relation("TaskAssignee")
  uploadedDocs    Document[]      @relation("DocumentUploader")
  reviewedDocs    Document[]      @relation("DocumentReviewer")
  createdRequests ClientRequest[] @relation("RequestCreator")
  messages        Message[]
  notifications   Notification[]
  sessions        Session[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@map("users")
}

model MagicLinkToken {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  requestedIp    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("magic_link_tokens")
}

model Session {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  tokenHash      String    @unique
  userAgent      String?
  ip             String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Clients & cases
// ---------------------------------------------------------------------------

model Client {
  id                   String   @id @default(uuid())
  organizationId       String
  firstName            String
  lastName             String
  email                String
  phone                String?
  telegramId           String?
  externalCrmContactId String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        Case[]
  requests     ClientRequest[]
  portalUser   User?

  @@unique([organizationId, email])
  @@index([organizationId, lastName])
  @@index([organizationId, externalCrmContactId])
  @@map("clients")
}

model Case {
  id                  String          @id @default(uuid())
  organizationId      String
  clientId            String
  assignedUserId      String?
  workflowTemplateId  String?
  title               String
  description         String?
  status              CaseStatus      @default(ACTIVE)
  currentStageId      String?         @unique
  progress            Int             @default(0)
  crmProvider         CrmProviderKind @default(NONE)
  externalCrmEntityId String?
  crmPipelineId       String?
  crmStageId          String?
  lastActivityAt      DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedUser User?             @relation("CaseAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  template     WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  currentStage CaseStage?        @relation("CaseCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)

  stages       CaseStage[]           @relation("CaseStages")
  requirements DocumentRequirement[]
  documents    Document[]
  requests     ClientRequest[]
  tasks        Task[]
  messages     Message[]
  events       Event[]

  @@unique([organizationId, externalCrmEntityId])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, assignedUserId])
  @@map("cases")
}

model CaseStage {
  id          String      @id @default(uuid())
  caseId      String
  name        String
  description String?
  position    Int
  status      StageStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  case         Case                  @relation("CaseStages", fields: [caseId], references: [id], onDelete: Cascade)
  currentOf    Case?                 @relation("CaseCurrentStage")
  requirements DocumentRequirement[]

  @@unique([caseId, position])
  @@index([caseId])
  @@map("case_stages")
}

model DocumentRequirement {
  id           String            @id @default(uuid())
  caseId       String
  stageId      String?
  name         String
  description  String?
  instructions String?
  required     Boolean           @default(true)
  deadline     DateTime?
  status       RequirementStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  case      Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  stage     CaseStage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  documents Document[]
  requests  ClientRequest[]

  @@index([caseId, status])
  @@map("document_requirements")
}

model Document {
  id              String         @id @default(uuid())
  organizationId  String
  caseId          String
  requirementId   String?
  uploadedById    String?
  uploadedByType  ActorType      @default(USER)
  version         Int            @default(1)
  filename        String
  storageKey      String         @unique
  mimeType        String
  fileSize        Int
  checksum        String?
  status          DocumentStatus @default(UPLOADED)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requirement  DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  uploadedBy   User?                @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy   User?                @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([caseId])
  @@index([requirementId, version])
  @@map("documents")
}

model ClientRequest {
  id             String        @id @default(uuid())
  organizationId String
  caseId         String
  clientId       String
  requirementId  String?
  type           RequestType   @default(DOCUMENT)
  title          String
  description    String?
  deadline       DateTime?
  status         RequestStatus @default(OPEN)
  createdById    String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User?                @relation("RequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  requirement  DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([caseId])
  @@map("client_requests")
}

model Task {
  id             String         @id @default(uuid())
  organizationId String
  caseId         String
  assignedToId   String?
  title          String
  description    String?
  deadline       DateTime?
  status         TaskStatus     @default(OPEN)
  visibility     TaskVisibility @default(INTERNAL)
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([caseId])
  @@map("tasks")
}

model Message {
  id             String    @id @default(uuid())
  organizationId String
  caseId         String
  senderId       String?
  senderType     ActorType @default(USER)
  body           String
  readByClientAt DateTime?
  readByStaffAt  DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("messages")
}

/// Immutable activity log. Rows are append-only: the service layer never
/// updates or deletes events.
model Event {
  id             String    @id @default(uuid())
  organizationId String
  caseId         String?
  actorType      ActorType
  actorId        String?
  actorLabel     String?
  eventType      EventType
  payload        Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([caseId, createdAt])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Workflow templates
// ---------------------------------------------------------------------------

model WorkflowTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       WorkflowTemplateStage[]
  cases        Case[]

  @@unique([organizationId, name])
  @@map("workflow_templates")
}

model WorkflowTemplateStage {
  id          String   @id @default(uuid())
  templateId  String
  name        String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template     WorkflowTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  requirements WorkflowTemplateRequirement[]
  crmMappings  CrmStageMapping[]

  @@unique([templateId, position])
  @@map("workflow_template_stages")
}

model WorkflowTemplateRequirement {
  id           String   @id @default(uuid())
  stageId      String
  name         String
  description  String?
  instructions String?
  required     Boolean  @default(true)
  deadlineDays Int?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stage WorkflowTemplateStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("workflow_template_requirements")
}

// ---------------------------------------------------------------------------
// CRM integration
// ---------------------------------------------------------------------------

model CrmConnection {
  id             String          @id @default(uuid())
  organizationId String
  provider       CrmProviderKind
  isActive       Boolean         @default(false)
  baseUrl        String?
  /// Inbound/outbound credentials. Never returned to the frontend verbatim.
  credentials    Json            @default("{}")
  webhookSecret  String?
  syncedFields   String[]        @default([])
  lastSyncedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings     CrmStageMapping[]
  deliveries   WebhookDelivery[]

  @@unique([organizationId, provider])
  @@map("crm_connections")
}

model CrmStageMapping {
  id                String   @id @default(uuid())
  connectionId      String
  pipelineId        String
  pipelineName      String?
  externalStageId   String
  externalStageName String?
  templateStageId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connection    CrmConnection          @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  templateStage WorkflowTemplateStage? @relation(fields: [templateStageId], references: [id], onDelete: SetNull)

  @@unique([connectionId, pipelineId, externalStageId])
  @@map("crm_stage_mappings")
}

/// Idempotency ledger for inbound CRM webhooks. A repeated delivery of the same
/// event is recorded once and never re-processed.
model WebhookDelivery {
  id           String          @id @default(uuid())
  connectionId String
  provider     CrmProviderKind
  externalKey  String
  status       String          @default("PROCESSED")
  payload      Json
  error        String?
  createdAt    DateTime        @default(now())

  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalKey])
  @@index([connectionId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(uuid())
  organizationId String
  userId         String?
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  templateKey    String
  subject        String
  body           String
  linkUrl        String?
  payload        Json                @default("{}")
  readAt         DateTime?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}
