# Sadullaev Marketing — настройки Apache для Beget
# Каждый блок обёрнут в IfModule: если модуля на сервере нет,
# строки просто игнорируются, а не роняют сайт с ошибкой 500.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Проверка Let's Encrypt ходит по http на /.well-known/ — её не трогаем,
  # иначе выпуск и продление сертификата могут не пройти.
  RewriteRule ^\.well-known/ - [L]

  # Всегда https и всегда без www (адрес совпадает с canonical на страницах).
  # Правила срабатывают только на боевом домене, поэтому сайт можно спокойно
  # проверить на техническом адресе хостинга.
  RewriteCond %{HTTP_HOST} ^(www\.)?sadullaev\.pro$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://sadullaev.pro%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.sadullaev\.pro$ [NC]
  RewriteRule ^ https://sadullaev.pro%{REQUEST_URI} [L,R=301]
</IfModule>

# Сжатие: страницы весят мегабайты, без него загрузка заметно медленнее
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# Кэширование: картинки надолго, страницы — нет, чтобы правки были видны сразу
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType application/xml       "access plus 1 day"
</IfModule>

# Служебные файлы наружу не отдаём.
# mod_authz_core — это Apache 2.4, mod_access_compat — синтаксис 2.2.
<FilesMatch "^(README\.md|set-domain\.sh|img_urls\.txt|.*\.zip|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

AddDefaultCharset UTF-8
